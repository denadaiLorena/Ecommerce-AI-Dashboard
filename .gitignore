# ==============================================================================
# FoodCommerce AI Dashboard - .gitignore
# ==============================================================================

# ── Variáveis de Ambiente & Segredos ──
.env
.env.*
!.env.example
*.env
backend/.env
frontend/.env*

# ── Python & Backend ──
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Ambientes Virtuais Python
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# Testes & Qualidade Python
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/

# ── Node.js, Frontend & Quasar ──
node_modules/
frontend/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Builds do Quasar e Vite
.quasar/
frontend/.quasar/
dist/
frontend/dist/
dist-ssr/
frontend/dist-ssr/
*.local
quasar.config.*.temporary.compiled*
frontend/quasar.config.*.temporary.compiled*

# Cordova & Capacitor (se gerados no Quasar)
/src-cordova/node_modules/
/src-cordova/platforms/
/src-cordova/plugins/
/src-cordova/www/
/src-capacitor/node_modules/
/src-capacitor/www/

# ── IDEs & Editores ──
.vscode/
**/.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~

# ── Sistema Operacional ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

